{"hits":{"hits":[{"id":"304043","metadata":{"authors":[{"full_name":"MacGibbon, J.H."},{"full_name":"Webber, B.R."}],"abstracts":[{"source":"APS","value":"We investigate the emission of quark and gluon jets from black holes with temperatures of 0.02-100 GeV, by convolving the Hawking emission formulas with a Monte Carlo QCD jet code. Jet emission may be astrophysically important particularly if black holes form from initial density perturbations in the early Universe. We find that the total emission differs dramatically from previous calculations and is dominated by the jet fragmentation products. The spectra have a significant component at energies well below the black-hole temperature, arising from the decays.","abstract_source_suggest":{"input":"APS"}}],"control_number":304043,"titles":[{"title":"Quark and gluon jet emission from primordial black holes: The instantaneous spectra"}]},"created":"1991-03-23T00:00:00+00:00","updated":"2023-03-10T09:29:23.153126+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/304043?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/304043?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/304043?format=latex-us","json":"https://inspirehep.net/api/literature/304043?format=json","json-expanded":"https://inspirehep.net/api/literature/304043?format=json-expanded","cv":"https://inspirehep.net/api/literature/304043?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A304043"}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.41.3052&size=1&page=1&fields=titles,abstracts,authors.full_name","bibtex":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.41.3052&size=1&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.41.3052&size=1&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2FPhysRevD.41.3052&size=1&page=1&format