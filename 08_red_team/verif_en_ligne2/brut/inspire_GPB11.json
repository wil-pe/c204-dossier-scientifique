{"hits":{"hits":[{"links":{"bibtex":"https://inspirehep.net/api/literature/900312?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/900312?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/900312?format=latex-us","json":"https://inspirehep.net/api/literature/900312?format=json","json-expanded":"https://inspirehep.net/api/literature/900312?format=json-expanded","cv":"https://inspirehep.net/api/literature/900312?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A900312"},"created":"2011-05-17T00:00:00+00:00","id":"900312","updated":"2024-04-16T15:42:22.691517+00:00","metadata":{"authors":[{"full_name":"Everitt, C.W.F."},{"full_name":"DeBra, D.B."},{"full_name":"Parkinson, B.W."},{"full_name":"Turneaure, J.P."},{"full_name":"Conklin, J.W."},{"full_name":"Heifetz, M.I."},{"full_name":"Keiser, G.M."},{"full_name":"Silbergleit, A.S."},{"full_name":"Holmes, T."},{"full_name":"Kolodziejczak, J."},{"full_name":"Al-Meshari, M."},{"full_name":"Mester, J.C."},{"full_name":"Muhlfelder, B."},{"full_name":"Solomonik, V.G."},{"full_name":"Stahl, K."},{"full_name":"Worden, P.W."},{"full_name":"Bencze, W."},{"full_name":"Buchman, S."},{"full_name":"Clarke, B."},{"full_name":"Al-Jadaan, A."},{"full_name":"Al-Jibreen, H."},{"full_name":"Li, J."},{"full_name":"Lipa, J.A."},{"full_name":"Lockhart, J.M."},{"full_name":"Al-Suwaidan, B."},{"full_name":"Taber, M."},{"full_name":"Wang, S."}],"publication_info":[{"journal_volume":"106","artid":"221101","year":2011,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214495"},"journal_title":"Phys.Rev.Lett."}],"abstracts":[{"source":"arXiv","value":"Gravity Probe B, launched 20 April 2004, is a space experiment testing two fundamental predictions of Einstein's theory of General Relativity (GR), the geodetic and frame-dragging effects, by means of cryogenic gyroscopes in Earth orbit. Data collection started 28 August 2004 and ended 14 August 2005. Analysis of the data from all four gyroscopes results in a geodetic drift rate of -6,601.8+/- 18.3 mas/yr and a frame-dragging drift rate of -37.2 +/- 7.2 mas/yr, to be compared with the GR predictions of -6,606.1 mas/yr and -39.2 mas/yr, respectively (`mas' is milliarc-second/ 1mas = 4.848 x 10-9 rad).","abstract_source_suggest":{"input":"arXiv"}}],"control_number":900312,"titles":[{"title":"Gravity Probe B: Final Results of a Space Experiment to Test General Relativity"},{"source":"arXiv","title":"Gravity Probe B: Final Results of a Space Experiment to Test General Relativity"}]}}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A1105.3456&size=1&page=1&fields=titles,abstracts,authors.full_name,publication_info","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A1105.3456&size=1&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%3A1105.3456&size=1&page=1&format=latex-eu","latex-us":"https://inspirehep.net/api/literature/?q=arxiv%3A1105.3456&size=1&page=1&format=latex-us","json":"https://inspirehep.net/api/literature/?q=arxiv%3A1105.3456&size=1&page=1&fields=titles,abstracts,authors.full_name,publication_info&format=json","json-expanded":"https://inspirehep.net/api/literature/?q=arxiv%3A1105.3456&size=1&page=1&format=json-expanded","cv":"https://inspirehep.net/api/literature/?q=arxiv%3A1105.3456&size=1&page=1&format=cv"}}