{"hits":{"hits":[{"updated":"2025-07-21T13:54:54.350451+00:00","links":{"bibtex":"https://inspirehep.net/api/literature/294118?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/294118?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/294118?format=latex-us","json":"https://inspirehep.net/api/literature/294118?format=json","json-expanded":"https://inspirehep.net/api/literature/294118?format=json-expanded","cv":"https://inspirehep.net/api/literature/294118?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A294118"},"metadata":{"authors":[{"full_name":"Bollinger, J.J."},{"full_name":"Heinzen, D.J."},{"full_name":"Itano, Wayne M."},{"full_name":"Gilbert, S.L."},{"full_name":"Wineland, D.J."}],"publication_info":[{"journal_volume":"63","page_end":"1034","year":1989,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214495"},"page_start":"1031","journal_title":"Phys.Rev.Lett."}],"abstracts":[{"source":"APS","value":"A hyperfine transition in the ground state of Be+9 was used to test a nonlinear generalization of quantum mechanics recently formulated by Weinberg. We searched for a dependence of the frequency of a coherent superposition of two hyperfine states on the populations of the states. We are able to set a limit of 4×10−27 on the fraction of binding energy per nucleon of the Be+9 nucleus that could be due to nonlinear corrections to quantum mechanics.","abstract_source_suggest":{"input":"APS"}}],"control_number":294118,"titles":[{"title":"Test of the linearity of quantum mechanics by rf spectroscopy of the Be+9 ground state"}]},"created":"2008-09-12T00:00:00+00:00","id":"294118"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.63.1031&size=1&page=1&fields=titles,abstracts,authors.full_name,publication_info","bibtex":"https://inspirehep.net/api/literature/?q=doi%3A10.1103%2Fphysrevlett.63.1031&size=1&page=1&format=bibtex","latex-eu":"https://