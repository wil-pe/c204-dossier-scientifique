{"hits":{"hits":[{"metadata":{"publication_info":[{"journal_volume":"41","page_end":"2130","year":2009,"journal_record":{"$ref":"https://inspirehep.net/api/journals/1214738"},"page_start":"2113","journal_title":"Gen.Rel.Grav."}],"authors":[{"full_name":"Neugebauer, Gernot"},{"full_name":"Hennig, Jorg"}],"abstracts":[{"source":"arXiv","value":"We resume former discussions of the question, whether the spin-spin repulsion and the gravitational attraction of two aligned black holes can balance each other. To answer the question we formulate a boundary value problem for two separate (Killing-) horizons and apply the inverse (scattering) method to solve it. Making use of results of Manko, Ruiz and Sanabria-G\\'omez and a novel black hole criterion, we prove the non-existence of the equilibrium situation in question.","abstract_source_suggest":{"input":"arXiv"}}],"control_number":821320,"titles":[{"title":"Non-existence of stationary two-black-hole configurations"},{"source":"arXiv","title":"Non-existence of stationary two-black-hole configurations"}]},"id":"821320","links":{"bibtex":"https://inspirehep.net/api/literature/821320?format=bibtex","latex-eu":"https://inspirehep.net/api/literature/821320?format=latex-eu","latex-us":"https://inspirehep.net/api/literature/821320?format=latex-us","json":"https://inspirehep.net/api/literature/821320?format=json","json-expanded":"https://inspirehep.net/api/literature/821320?format=json-expanded","cv":"https://inspirehep.net/api/literature/821320?format=cv","citations":"https://inspirehep.net/api/literature/?q=refersto%3Arecid%3A821320"},"created":"2009-05-26T00:00:00+00:00","updated":"2023-03-07T00:09:45.798108+00:00"}],"total":1},"links":{"self":"https://inspirehep.net/api/literature/?q=arxiv%3A0905.4179&size=1&page=1&fields=titles,abstracts,authors.full_name,publication_info","bibtex":"https://inspirehep.net/api/literature/?q=arxiv%3A0905.4179&size=1&page=1&format=bibtex","latex-eu":"https://inspirehep.net/api/literature/?q=arxiv%